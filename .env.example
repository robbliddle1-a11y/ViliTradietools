# Copy to .env.local. Anything left blank runs in mock/test mode.

NEXT_PUBLIC_APP_URL=http://localhost:3000
# 32+ random chars. REQUIRED in production: openssl rand -base64 48
SESSION_SECRET=

# --- Database (Supabase → Project Settings → Database → Connection string, "Transaction pooler") ---
DATABASE_URL=

# --- Auth codes (Supabase → Project Settings → API) ---
# In Supabase: Auth → Providers → Phone: enable, provider Twilio (or Twilio Verify).
# Auth → Email templates → "Magic Link": include {{ .Token }} and link to
#   {{ .SiteURL }}/login/callback?token_hash={{ .TokenHash }}&type=email
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # storage uploads; create a PRIVATE bucket named "level"

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=       # endpoint: /api/stripe/webhook
STRIPE_PRICE_ID=             # the one recurring price that unlocks all paid tools
NEXT_PUBLIC_PRICE_LABEL=     # e.g. "$39/month inc GST"
